#!/bin/sh
set -e
while read -r local_ref local_oid remote_ref remote_oid; do
  case "$remote_ref" in
    refs/heads/*)
      [ "$local_ref" != '(delete)' ] || continue
      bash scripts/check-git-policy.sh branch "${remote_ref#refs/heads/}"
      ;;
  esac
done
exec dotnet test MultiTenantPlatform.slnx -c Release
